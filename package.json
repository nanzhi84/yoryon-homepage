{
  "name": "yoryon-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @yoryon/web",
    "dev:web": "npm run dev -w @yoryon/web",
    "dev:gomoku": "npm run dev -w @yoryon/gomoku",
    "dev:digit-ocr": "npm run dev -w @yoryon/digit-ocr",
    "build": "npm run build -w @yoryon/web && npm run build -w @yoryon/gomoku && npm run build -w @yoryon/digit-ocr",
    "test:gomoku": "npm test -w @yoryon/gomoku",
    "preview": "npm run preview -w @yoryon/web"
  }
}
