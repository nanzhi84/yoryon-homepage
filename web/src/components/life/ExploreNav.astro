---
interface Props { active: "timeline" | "projects" | "topics" | "collections" }
const {active}=Astro.props;
const items=[['timeline','时间线','/#timeline'],['projects','项目','/projects/'],['topics','主题','/topics/'],['collections','系列','/collections/']];
---
<nav class="explore-nav" aria-label="探索开源人生">
 {items.map(([id,label,href])=><a href={href} aria-current={active===id?'page':undefined}>{label}</a>)}
 <a class="explore-search" href="/explore/" aria-label="搜索全部内容"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><circle cx="10" cy="10" r="6.5"/><path d="m15 15 5 5"/></svg></a>
</nav>
