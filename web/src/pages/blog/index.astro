---
import { getCollection } from "astro:content";
import SiteShell from "../../layouts/SiteShell.astro";

const getPostSlug = (post) => post.slug ?? post.id.replace(/\.(mdoc|mdx?)$/, "");
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date) => new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(date);

const groupedByYear = posts.reduce((groups, post) => {
  const year = post.data.pubDate.getFullYear();
  const last = groups[groups.length - 1];
  if (last && last.year === year) {
    last.posts.push(post);
  } else {
    groups.push({ year, posts: [post] });
  }
  return groups;
}, []);
---

<SiteShell
  title="Thinking | Yoryon"
  description="Yoryon 的博客与思考页面，记录产品、成长、写作和复盘。"
  activeNav="thinking"
>
  <main class="blog-main">
    <section class="archive-hero container section">
      <div class="archive-heading reveal">
        <a class="back-link" href="/#thinking">← 返回首页</a>
        <h1>Thinking</h1>
        <p>记录产品观察、成长复盘和还在形成中的判断。</p>
      </div>
    </section>

    <section class="container section" id="latest">
      <div class="section-heading reveal">
        <div>
          <h2>All notes</h2>
          <p>全部文章</p>
        </div>
      </div>
      <div class="archive-groups">
        {groupedByYear.map(({ year, posts: yearPosts }) => (
          <div class="archive-year-group reveal">
            <div class="archive-year" aria-hidden="true">{year}</div>
            <div class="article-list">
              {yearPosts.map((post) => (
                <a class="article-row" href={`/blog/${getPostSlug(post)}/`}>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <article>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <ul class="tag-list">
                        {post.data.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
                      </ul>
                    )}
                  </article>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>
  </main>
</SiteShell>
