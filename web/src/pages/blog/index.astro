---
import { getCollection } from "astro:content";
import SiteShell from "../../layouts/SiteShell.astro";

const getPostSlug = (post) => post.slug ?? post.id.replace(/\.(mdoc|mdx?)$/, "");
const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// frontmatter 裸日期按 UTC 午夜解析，格式化必须用 UTC 取值，否则西半球时区会提前一天
const formatDate = (date) => date.toISOString().slice(0, 10);
---

<SiteShell
  title="Thinking | Yoryon"
  description="Yoryon（釉蓝yoryon）的博客与思考页面，记录 AI 产品观察、成长复盘和还在形成中的判断。"
  activeNav="thinking"
  bodyClass="archive-index-page"
>
  <main class="blog-main">
    <section class="archive-hero container">
      <div class="archive-heading reveal">
        <a class="back-link" href="/#thinking">&larr; 返回首页</a>
        <h1>Thinking</h1>
        <p>记录 AI 产品观察、成长复盘和还在形成中的判断。</p>
        <span class="archive-count">共 {posts.length} 篇</span>
      </div>
    </section>

    <section class="section" id="latest">
      <div class="container">
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-row reveal" href={`/blog/${getPostSlug(post)}/`}>
                <time class="post-date" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                <div>
                  <h3 class="post-title">{post.data.title}</h3>
                  <p class="post-desc">{post.data.description}</p>
                </div>
                <span class="post-arr" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </main>
</SiteShell>
