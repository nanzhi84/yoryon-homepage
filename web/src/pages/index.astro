---
import LifeTimeline from "../components/LifeTimeline.astro";
import SiteShell from "../layouts/SiteShell.astro";
import { formatLifeDays, getLifeDays } from "../lib/life-clock";
---

<SiteShell
  title="开源我的人生 | Yoryon"
  description="Yoryon（釉蓝yoryon）的个人主页：AI 产品、LLM 应用、Agent 工作流与模型评测的思考、写作和项目实践。"
  activeNav="home"
  bodyClass="home-particle-page open-life-page archive-home"
>
  <main class="home-main">
    <section class="archive-home-hero life-container" id="home" aria-label="开源我的人生">
      <div><h1>开源我的人生</h1><div class="archive-life-clock"><span data-life-days>{formatLifeDays(getLifeDays())}</span> 天<small>SINCE <time datetime="2004-11-26">2004.11.26</time></small></div><p>经历、作品与思考，在这里发生。</p></div>
      <aside>更大的世界<br/>始于真实的记录。<span>Life<br/>is a longer story.</span></aside>
    </section>

    <LifeTimeline />

    <section class="life-subscription-band" id="subscription" aria-labelledby="life-subscription-title">
      <div class="life-container">
        <div class="life-subscription-copy reveal">
          <p class="life-eyebrow">SUBSCRIPTION</p>
          <h2 id="life-subscription-title">让记录，继续发生。</h2>
          <p>从公开内容开始，持续读下去。</p>
          <div class="life-subscription-actions">
            <a href="/subscribe/">了解订阅 <span class="life-arrow" aria-hidden="true">↗</span></a>
            <span>内容订阅筹备中</span>
          </div>
        </div>
      </div>
      <canvas class="life-galaxy-particles" data-event-horizon-field data-particle-pattern="galaxy" aria-hidden="true"></canvas>
    </section>

    <section class="life-section life-about-section" id="about">
      <div class="life-container">
        <header class="life-about-heading reveal"><p class="life-eyebrow">ABOUT</p><h2>关于 Yoryon</h2></header>
        <div class="life-about-grid">
          <p class="life-philosophy reveal" lang="en">Invert,<br />always invert.</p>
          <div class="life-about-copy reveal">
            <h3>我是 AI 降临派。</h3>
            <p>把 AI 当作自己思维和创造力的延伸，<br class="life-desktop-break" />毫无保留地拥抱这一代人独有的能力。</p>
            <p>我关心技术，也关心产品如何活下去。<br class="life-desktop-break" />造东西和下注，在我眼里是同一件事。</p>
            <p class="life-about-detail">从需求拆解、系统设计到上线迭代，<br class="life-desktop-break" />用 AI 重新定义一个产品该怎么运转。</p>
            <span class="life-profile-meta">YORYON / AI PRODUCT / BORN IN 2004</span>
          </div>
        </div>
      </div>
    </section>

    <section class="life-section life-contact-section" id="contact">
      <div class="life-container life-contact-grid">
        <div class="life-contact-heading reveal">
          <p class="life-eyebrow">CONTACT</p>
          <h2>保持联系。</h2>
          <p class="life-contact-note">Open to AI products, writing,<br />and good questions.</p>
        </div>
        <dl class="life-socials reveal" aria-label="社交与自媒体账号">
          <div>
            <dt>GitHub</dt>
            <dd><a href="https://github.com/nanzhi84" target="_blank" rel="noopener noreferrer">nanzhi84 <span class="life-arrow" aria-hidden="true">↗</span></a></dd>
          </div>
          <div><dt>微信公众号</dt><dd>釉蓝yoryon</dd></div>
          <div>
            <dt>小红书</dt>
            <dd><a href="https://www.xiaohongshu.com/user/profile/649ade98000000001001d1dc" target="_blank" rel="noopener noreferrer">釉蓝yoryon <span class="life-arrow" aria-hidden="true">↗</span></a></dd>
          </div>
          <div>
            <dt>抖音</dt>
            <dd><a href="https://www.douyin.com/user/MS4wLjABAAAAKYi5Z7LC-1B1YgY8kYdN2DrKqwtdTvZ4I0lodLekyOs" target="_blank" rel="noopener noreferrer">釉蓝yoryon <span class="life-arrow" aria-hidden="true">↗</span></a></dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <script>
    import "../scripts/home-smooth-scroll";
    import "../scripts/life-clock";
  </script>
</SiteShell>
