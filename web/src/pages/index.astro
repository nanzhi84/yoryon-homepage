---
import { getCollection } from "astro:content";
import SiteShell from "../layouts/SiteShell.astro";

const getEntrySlug = (entry) => entry.slug ?? entry.id.replace(/\.(mdoc|mdx?)$/, "");
const formatDate = (date) => new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit"
}).format(date);

const recentPosts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const [featuredPost, ...restPosts] = recentPosts;

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteShell
  title="Yoryon | Personal Homepage"
  description="Yoryon 的电影感个人主页，记录 AI 产品、写作、Agent 工作流与项目实践。"
  activeNav="home"
>
  <main class="home-main">
    <section class="hero" id="home" aria-label="首页介绍">
      <div class="hero-media" aria-hidden="true">
        <img src="/assets/cinematic-home-hero.png" alt="" width="1672" height="941"
             decoding="async" fetchpriority="high" />
      </div>
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="container hero-inner">
        <div class="hero-copy">
          <p class="hero-role">Yoryon · AI 产品与 Agent 工作流</p>
          <h1>把 AI 想法<br />拍成可用产品</h1>
          <p class="hero-desc">我做 LLM 应用与 Agent 工作流。这里是我的项目片场与写作档案。</p>
          <div class="hero-actions">
            <a class="button-primary" href="#projects">查看精选项目</a>
            <a class="button-secondary" href="#thinking">阅读技术文章</a>
          </div>
        </div>
      </div>
    </section>

    <section class="about container section" id="about">
      <div class="section-aside reveal">
        <h2>创作者档案</h2>
      </div>
      <div class="about-content reveal reveal-delay">
        <p class="section-lead">我叫 Yoryon，目前在北京邮电大学读本科，专业是信息与计算科学。</p>
        <p>我关注 AI 产品方向，喜欢把 LLM 应用、Agent 工作流和模型评测这些事拆解清楚，再落地成产品。</p>
        <p>正在做的事：从用户场景、机制设计到工程协作，把 AI 能力跑成真实可用的体验，并通过写作沉淀认知、记录成长。</p>
        <dl class="fact-list">
          <div><dt>身份</dt><dd>北京邮电大学 在读 · 信息与计算科学</dd></div>
          <div><dt>方向</dt><dd>AI 产品 · LLM 应用 · Agent 工作流 · 模型评测</dd></div>
          <div><dt>方式</dt><dd>观察 · 思考 · 实践 · 复盘</dd></div>
          <div><dt>工具</dt><dd>Python、TypeScript、Next.js、NestJS、PostgreSQL、PyTorch</dd></div>
          <div><dt>邮箱</dt><dd><a href="mailto:zhouyangyang@bupt.edu.cn">zhouyangyang@bupt.edu.cn</a></dd></div>
        </dl>
      </div>
    </section>

    <section class="container section" id="thinking">
      <div class="section-heading reveal">
        <h2>最近的思考与写作</h2>
        <a href="/blog/" class="text-link">查看全部文章 →</a>
      </div>

      {featuredPost && (
        <a class="featured-post reveal" href={`/blog/${getEntrySlug(featuredPost)}/`}>
          <time datetime={featuredPost.data.pubDate.toISOString()}>{formatDate(featuredPost.data.pubDate)}</time>
          <h3>{featuredPost.data.title}</h3>
          <p>{featuredPost.data.description}</p>
          <span class="featured-action" aria-hidden="true">阅读 →</span>
        </a>
      )}

      <div>
        {restPosts.map((post, index) => (
          <a class:list={["post-row", "reveal", { "reveal-delay-2": index === 0, "reveal-delay-3": index === 1 }]} href={`/blog/${getEntrySlug(post)}/`}>
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="container section" id="projects">
      <div class="section-heading reveal">
        <h2>精选项目</h2>
        <a href="#contact" class="text-link">聊聊合作或想法 →</a>
      </div>
      <div class="project-list">
        {projects.map((project, index) => (
          <a class:list={["project-row", "reveal", { "reveal-delay-2": index === 1, "reveal-delay-3": index === 2 }]} href={`/projects/${getEntrySlug(project)}/`}>
            <span class="project-kicker">{project.data.type} / {project.data.platform}</span>
            <div class="project-row-main">
              <h3>{project.data.title}</h3>
              <p>{project.data.summary}</p>
            </div>
            <span class="project-stack">{project.data.stack}</span>
            <span class="project-action" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="container section contact-scene" id="contact">
      <div class="reveal">
        <h2>下一场镜头</h2>
        <p>有 AI 产品想法、项目合作或写作交流，欢迎随时联系。</p>
        <div class="contact-links">
          <a href="mailto:zhouyangyang@bupt.edu.cn">Email</a>
          <a href="https://github.com/nanzhi84" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
      </div>
    </section>
  </main>
</SiteShell>
