---
import { getCollection } from "astro:content";
import SiteShell from "../../layouts/SiteShell.astro";

const getEntrySlug = (entry) => entry.slug ?? entry.id.replace(/\.(mdoc|mdx?)$/, "");
const projects = (await getCollection("projects"))
  .filter((project) => !project.data.hidden)
  .sort((a, b) => a.data.order - b.data.order);
---

<SiteShell
  title="Projects | Yoryon"
  description="Yoryon（釉蓝yoryon）的项目档案：从评测基准到产品落地的完整项目列表。"
  activeNav="projects"
  bodyClass="archive-index-page"
>
  <main class="projects-main">
    <section class="archive-hero container">
      <div class="archive-heading reveal">
        <a class="back-link" href="/#projects">&larr; 返回首页</a>
        <h1>Projects</h1>
        <p>从评测基准到产品落地，做过的东西都在这里。</p>
        <span class="archive-count">共 {projects.length} 个项目</span>
      </div>
    </section>

    <section class="section" id="all-projects">
      <div class="container">
        <ol class="proj-index">
          {projects.map((project, index) => (
            <li>
              <a class="proj-row reveal" href={`/projects/${getEntrySlug(project)}/`}>
                <span class="proj-num">{String(index + 1).padStart(2, "0")}</span>
                {project.data.cover && (
                  <span class="proj-cover">
                    <img
                      src={project.data.cover}
                      alt=""
                      width="1600"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                )}
                <div class="proj-body">
                  <h3 class="proj-title">{project.data.title}</h3>
                  <p class="proj-desc">{project.data.summary}</p>
                  <p class="proj-meta">{project.data.period} · {project.data.role}</p>
                  <span class="proj-tags">{project.data.stack}</span>
                </div>
                <span class="proj-arr" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </main>
</SiteShell>
