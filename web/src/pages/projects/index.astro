---
import ArchiveShell from "../../layouts/ArchiveShell.astro";
import ProjectPreview from "../../components/life/ProjectPreview.astro";
import {getLifeGraph} from "../../lib/open-life";
const {projects:allProjects}=await getLifeGraph();
const projects=[...allProjects].sort((a,b)=>Number(b.id==='lilink')-Number(a.id==='lilink'));
---
<ArchiveShell variant="reference-projects" title="项目" description="这些项目，串起不同阶段的尝试、验证与成长。" active="projects"><header class="archive-page-heading"><p class="archive-kicker">THINGS I HAVE BUILT</p><h1>做过的事，留下的作品。</h1><p>这些项目，串起不同阶段的尝试、验证与成长。</p></header>{projects.map(project=><ProjectPreview project={project}/>)}</ArchiveShell>
