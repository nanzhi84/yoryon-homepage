---
interface Props {
  title: string;
  description: string;
  activeNav?: "home" | "about" | "thinking" | "projects" | "contact" | "life" | "subscribe";
  bodyClass?: string;
  particleBackground?: boolean;
}

const { title, description, activeNav, bodyClass, particleBackground = false } = Astro.props;
const isHome = activeNav === "home";
const showParticles = isHome || particleBackground;
const isLife = ["home", "thinking", "projects", "life"].includes(activeNav ?? "");

const navItems = [
  { id: "home", label: "开源我的人生", homeHref: "#home", siteHref: "/" },
  { id: "about", label: "关于", homeHref: "#about", siteHref: "/#about" },
  { id: "contact", label: "Contact", homeHref: "#contact", siteHref: "/#contact" }
];
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {showParticles && (
      <script is:inline>
        if (typeof Worker === "function") {
          try {
            const worker = new Worker("/js/particle-worker.js");
            worker.addEventListener("error", () => {
              if (window.__yoryonParticleWorker === worker) {
                worker.terminate();
                delete window.__yoryonParticleWorker;
              }
            }, { once: true });
            window.__yoryonParticleWorker = worker;
            window.setTimeout(() => {
              if (window.__yoryonParticleWorker === worker) {
                worker.terminate();
                delete window.__yoryonParticleWorker;
              }
            }, 10000);
          } catch {}
        }
      </script>
    )}
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/open-life.css" />
    <link rel="stylesheet" href="/css/life-archive.css" />
    <!-- 进场动效的初始隐藏态只在 JS 可用时生效，避免无 JS 时内容不可见 -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body class:list={["life-shell", bodyClass]}>
    <header class="site-header" id="top">
      <div class="container header-inner">
        <a class="brand" href={isHome ? "#home" : "/#home"}>Yoryon</a>
        <nav class="nav" id="site-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={isHome ? item.homeHref : item.siteHref} class:list={["nav-link", { "is-active": item.id === "home" ? isLife : activeNav === item.id }]} aria-current={(item.id === "home" ? isLife : activeNav === item.id) ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
        <a class:list={["nav-subscribe", { "is-active": activeNav === "subscribe" }]} href="/subscribe/" aria-current={activeNav === "subscribe" ? "page" : undefined}>订阅 <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    {showParticles && <canvas class="hero-particles" data-particle-field aria-hidden="true"></canvas>}
    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>&copy; 2026 Yoryon</p>
        <nav class="footer-nav" aria-label="页脚导航">
          {isHome ? <a href="#home">回到顶部 <span aria-hidden="true">↑</span></a> : navItems.map((item) => (
            <a href={isHome ? item.homeHref : item.siteHref}>{item.label}</a>
          ))}
        </nav>
      </div>
    </footer>

    <!-- 脚本加载失败时去掉 js 门控，并恢复由脚本接管的延迟图片 -->
    <script
      src="/js/script.js"
      defer
      onerror="document.documentElement.classList.remove('js');document.querySelectorAll('img[data-src],img[data-lazy-src]').forEach((image)=>{image.src=image.dataset.src||image.dataset.lazySrc})"
    ></script>
  </body>
</html>
